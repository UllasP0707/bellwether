# Copy to .env. Local development defaults; nothing here is a real secret.
BELLWETHER_TENANT_ID=acme
BELLWETHER_KAFKA_BOOTSTRAP=localhost:9092
BELLWETHER_SCHEMA_REGISTRY=http://localhost:8081
BELLWETHER_POSTGRES_DSN=postgresql://bellwether:bellwether@localhost:5432/bellwether
BELLWETHER_REDIS_URL=redis://localhost:6379/0
BELLWETHER_S3_ENDPOINT=http://localhost:9000
BELLWETHER_S3_BUCKET=bellwether-lake
BELLWETHER_S3_ACCESS_KEY=bellwether
BELLWETHER_S3_SECRET_KEY=bellwetherbellwether
BELLWETHER_LOG_LEVEL=INFO

# Optional: enables Claude-generated intervention copy. Falls back to static
# templates when unset.
# ANTHROPIC_API_KEY=
